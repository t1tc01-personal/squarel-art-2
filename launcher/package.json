{
  "name": "squarel-art-launcher",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "Squarel Art Launcher",
  "license": "PolyForm-Shield-1.0.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "icon": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-icon.mts",
    "dist": "pnpm build && pnpm icon && electron-builder --win --publish never",
    "test": "vitest run",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check src test scripts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "electron-updater": "6.8.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "author": "Squarel Art"
}
