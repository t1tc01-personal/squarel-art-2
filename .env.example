# Copy to .env and fill in. .env is git-ignored.

# Where projects, versions, proposals and exports live
DATA_DIR=D:\SquarelArt-data

# Default image provider for quality "free": cloudflare | local-sd | mock
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI (free tier: 10,000 neurons/day)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Retro Diffusion (optional, paid, used for quality "high" only after confirm_cost)
RETRO_DIFFUSION_API_KEY=

# Optional local Stable Diffusion service (services/local-sd)
LOCAL_SD_URL=http://127.0.0.1:7861

# Hard cap on paid image spend per day (USD)
IMAGE_DAILY_BUDGET_USD=1

# Default preview size (px, longest side) returned to Claude
PREVIEW_DEFAULT_PX=256

# Aseprite bridge
BRIDGE_PORT=4321
ASEPRITE_PATH=C:\Program Files\Aseprite\Aseprite.exe
