{
  "name": "squarel-art",
  "version": "0.4.0",
  "private": true,
  "description": "Pixel art toolkit plugged into Claude Code (MCP) with two-way Aseprite sync",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "squarel": "src/cli/index.ts"
  },
  "scripts": {
    "mcp": "node src/mcp/index.ts",
    "bridge": "node src/bridge/index.ts",
    "cli": "node src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts integrations/schema",
    "format": "biome format --write src test scripts integrations/schema",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "aseprite:build": "node scripts/aseprite-build.ts",
    "aseprite:pack": "node scripts/pack-aseprite.ts",
    "aseprite:test": "node scripts/aseprite-roundtrip.ts",
    "eval": "node evals/run.ts",
    "docs:tools": "node scripts/gen-tools-doc.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chokidar": "^6.0.0",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "fengari": "^0.1.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
